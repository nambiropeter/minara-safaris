DATABASE_URI=
PAYLOAD_SECRET=
PAYLOAD_CONFIG_PATH=src/payload.config.mts
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Consultant inbox for the "Email us" buttons. Buttons hide until set.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional. Without it the open exchangerate-api endpoint is used. Rates are
# cached for 24h either way — never fetched per visit.
EXCHANGERATE_API_KEY=

# Pending domain from client. Drives metadataBase/canonical/sitemap AND the Plausible
# domain (derived from this, not a separate var) — Plausible stays off until this is set.
NEXT_PUBLIC_SITE_URL=

R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Lead notification email (all three pending from client — leads still save without them)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEADS_NOTIFICATION_EMAIL=
# Stripe. Test-mode keys need no merchant account — create an account, pick
# United Kingdom as the country, and copy the test keys.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
