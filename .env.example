DATABASE_URI=
PAYLOAD_SECRET=
PAYLOAD_CONFIG_PATH=src/payload.config.mts
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Pending domain from client. Drives metadataBase/canonical/sitemap AND the Plausible
# domain (derived from this, not a separate var) — Plausible stays off until this is set.
NEXT_PUBLIC_SITE_URL=

R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email via Resend (all pending from client). LEADS_NOTIFICATION_EMAIL also receives
# paid-booking, refund and refused-payment alerts. Customer booking emails additionally
# need NEXT_PUBLIC_SITE_URL, since they link to the booking page.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEADS_NOTIFICATION_EMAIL=
# Stripe. Test-mode keys need no merchant account — create an account, pick
# United Kingdom as the country, and copy the test keys.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
