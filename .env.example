DATABASE_URI=
PAYLOAD_SECRET=
PAYLOAD_CONFIG_PATH=src/payload.config.mts
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional. Without it the open exchangerate-api endpoint is used. Rates are
# cached for 24h either way — never fetched per visit.
EXCHANGERATE_API_KEY=

# Pending domain from client. Drives metadataBase/canonical/sitemap AND the Plausible
# domain (derived from this, not a separate var) — Plausible stays off until this is set.
NEXT_PUBLIC_SITE_URL=

R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Enquiry emails go via Formspree (the inbox is set on the form in Formspree's
# dashboard). Just the form id from https://formspree.io/f/<id>. Leads still
# save to Payload without it.
FORMSPREE_FORM_ID=

# Booking confirmation emails (with the invoice PDF attached) still use Resend.
# Resend also sends paid-booking, refund and refused-payment alerts. Customer
# booking emails additionally need NEXT_PUBLIC_SITE_URL, since they link to the
# booking page.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEADS_NOTIFICATION_EMAIL=
# Stripe. Test-mode keys need no merchant account — create an account, pick
# United Kingdom as the country, and copy the test keys.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Hotelbeds hotel search. Key and secret from the developer portal (the test host needs no
# contract). HOTEL_MARGIN_BPS is only a fallback markup (basis points, 1500 = 15%) used until a
# margin is saved under Hotel settings in the admin; the admin value wins. With neither, search
# refuses to run rather than selling at cost. HOTELBEDS_BASE_URL defaults to the test host.
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
HOTELBEDS_BASE_URL=
HOTEL_MARGIN_BPS=
